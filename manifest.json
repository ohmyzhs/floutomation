{
  "manifest_version": 3,
  "name": "Flow Batch Studio",
  "description": "Google Flow 이미지 프롬프트를 안전한 간격으로 순차 실행합니다.",
  "version": "0.9.18",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "offscreen",
    "power",
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "https://flow.google.com/*",
    "https://fow.google/*",
    "https://flow-content.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flow Batch Studio 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google/project/*",
        "https://flow.google.com/project/*",
        "https://fow.google/project/*"
      ],
      "include_globs": [
        "https://labs.google/fx/tools/flow/*",
        "https://labs.google/fx/*/tools/flow/*",
        "https://flow.google/project/*",
        "https://flow.google.com/project/*",
        "https://fow.google/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
